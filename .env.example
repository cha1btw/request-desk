# Copy to `.env` and replace the placeholder values. Never commit `.env`.

# --- PostgreSQL (used by the postgres container and by the API) ---
POSTGRES_USER=request_desk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=request_desk
# Port published on your machine (change if 5432 is already taken)
POSTGRES_PORT=5432

# --- API ---
PORT=3000
# `localhost` when the API runs on your machine; Docker Compose overrides it with `postgres`
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=request_desk
DATABASE_PASSWORD=change-me
DATABASE_NAME=request_desk

# --- Auth ---
# Must be at least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime in seconds (default: 8 hours)
JWT_EXPIRES_IN_SECONDS=28800

# --- Seed script (npm run seed) ---
# Password given to the demo users the seed creates (min 8 characters). Dev only.
SEED_PASSWORD=change-me-seed
